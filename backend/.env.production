# Production environment. Generate unique production secrets before use.
SPRING_PROFILES_ACTIVE=prod
COMPOSE_PROJECT_NAME=pixel-ledger
MYSQL_DATABASE=pixel_ledger
MYSQL_USER=pixel_ledger
MYSQL_PASSWORD=replace-with-a-long-random-production-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-production-password
REDIS_PASSWORD=replace-with-a-third-long-random-production-password
JWT_SECRET=replace-with-at-least-32-random-production-characters
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-production-admin-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=replace-me
MAIL_FROM=Pixel Ledger <mailer@example.com>
APP_PUBLIC_URL=https://api.example.com
